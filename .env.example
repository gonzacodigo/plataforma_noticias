# Copiar a .env y completar. Nunca subir .env a Git.
DJANGO_SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_DE_64_CARACTERES
DB_NAME=plataforma_noticias
DB_USER=postgres
DB_PASSWORD=REEMPLAZAR
DB_HOST=localhost
DB_PORT=5432
SITE_URL=https://www.desenchufadas.com
ALLOWED_HOSTS=www.desenchufadas.com,desenchufadas.com
CSRF_TRUSTED_ORIGINS=https://www.desenchufadas.com,https://desenchufadas.com
USE_SQLITE=false
# Activar solo si un proxy confiable elimina/reemplaza X-Forwarded-Proto.
TRUST_PROXY_HTTPS=false
SCRAPE_MAX_ARTICLES=30
SCRAPE_BUDGET_SECONDS=90
